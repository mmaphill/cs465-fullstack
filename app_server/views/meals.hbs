<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>Foods - Travlr Getaways Website Template</title>
    <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            {{{ title }}} 
                            <ul id="foods">
                                <li>
                                    {{#each foods }}
                                        {{{ subtitle }}}
                                    <div class="infos">
                                            {{{ image }}}
                                            {{{ description }}} 
                                    </div>
                                    <br />
                                    <hr />
                                    {{/each}}
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{> footer }}
    </div>
</body>
</html>