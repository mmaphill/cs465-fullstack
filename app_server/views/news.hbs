<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>News - Travlr Getaways Website Template</title>
    <link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}
            <div id="contents">
                <div class="box">
                    <div>
                        <div id="news" class="body">
                            <div class="sidebar">
                                {{#each latest }}
                                {{{ subtitle }}}
                                <ul>
                                    <li>
                                        {{{ item }}}
                                    </li>
                                </ul>
                                {{/each}}
                                {{#each tips }}
                                {{{ subtitle }}}
                                <ul>
                                    <li>
                                        {{{ item }}}
                                    </li>
                                </ul>
                                {{/each}}
                            </div>
                            <div>
                                {{{ title }}}
                                {{{ image }}}
                                {{{ subtitle }}}
                                {{{ description }}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{> footer }}
    </div>
</body>
</html>