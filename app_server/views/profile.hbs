<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>My Profile - Travlr Getaways</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header }}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>My Profile</h1>
                            <form method="POST" action="/profile/update" style="max-width: 600px; margin: 0 auto;">
                                <fieldset style="border: 1px solid #ddd; padding: 20px; margin-bottom: 20px; border-radius: 4px;">
                                    <legend style="font-weight: bold; font-size: 16px;">Personal Information</legend>

                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px;">
                                        <div class="form-group">
                                            <label for="firstName" style="display: block; margin-bottom: 5px;">First Name</label>
                                            <input type="text" class="form-control" id="firstName" name="firstName" value="{{profile.firstName}}" style="width: 100%; padding: 8px;">
                                        </div>
                                        <div class="form-group">
                                            <label for="lastName" style="display: block; margin-bottom: 5px;">Last Name</label>
                                            <input type="text" class="form-control" id="lastName" name="lastName" value="{{profile.lastName}}" style="width: 100%; padding: 8px;">
                                        </div>
                                    </div>

                                    <div class="form-group" style="margin-bottom: 15px;">
                                        <label for="bio" style="display: block; margin-bottom: 5px;">Bio</label>
                                        <textarea class="form-control" id="bio" name="bio" rows="3" style="width: 100%; padding: 8px;">{{profile.bio}}</textarea>
                                    </div>
                                </fieldset>

                                <fieldset style="border: 1px solid #ddd; padding: 20px; margin-bottom: 20px; border-radius: 4px;">
                                    <legend style="font-weight: bold; font-size: 16px;">Travel Preferences</legend>

                                    <div class="form-group" style="margin-bottom: 15px;">
                                        <label for="preferredTravelStyle" style="display: block; margin-bottom: 5px;">Preferred Travel Style</label>
                                        <select class="form-control" id="preferredTravelStyle" name="preferredTravelStyle" style="width: 100%; padding: 8px;">
                                            <option value="">Select a style</option>
                                            <option value="luxury" {{#if (eq profile.preferredTravelStyle 'luxury')}} selected{{/if}}>Luxury</option>
                                            <option value="budget" {{#if (eq profile.preferredTravelStyle 'budget')}} selected{{/if}}>Budget</option>
                                            <option value="adventure" {{#if (eq profile.preferredTravelStyle 'adventure')}} selected{{/if}}>Adventure</option>
                                            <option value="relaxation" {{#if (eq profile.preferredTravelStyle 'relaxation')}} selected{{/if}}>Relaxation</option>
                                        </select>
                                    </div>

                                    <div class="form-group" style="margin-bottom: 15px;">
                                        <label for="favoriteDestinations" style="display: block; margin-bottom: 5px;">Favorite Destinations (comma separated)</label>
                                        <input type="text" class="form-control" id="favoriteDestinations" name="favoriteDestinations"
                                               value="{{profile.favoriteDestinations}}" placeholder="e.g., Paris, Tokyo, New York" style="width: 100%; padding: 8px;">
                                    </div>
                                </fieldset>

                                <fieldset style="border: 1px solid #ddd; padding: 20px; margin-bottom: 20px; border-radius: 4px;">
                                    <legend style="font-weight: bold; font-size: 16px;">Settings</legend>

                                    <div class="form-group" style="margin-bottom: 15px;">
                                        <label for="theme" style="display: block; margin-bottom: 5px;">Theme</label>
                                        <select class="form-control" id="theme" name="theme" style="width: 100%; padding: 8px;">
                                            <option value="light" {{#if (eq profile.preferences.theme 'light')}} selected{{/if}}>Light</option>
                                            <option value="dark" {{#if (eq profile.preferences.theme 'dark')}} selected{{/if}}>Dark</option>
                                        </select>
                                    </div>

                                    <div class="form-group" style="margin-bottom: 15px;">
                                        <label style="display: flex; align-items: center; gap: 10px;">
                                            <input type="checkbox" id="notifications" name="notifications"
                                                   {{#if profile.preferences.notifications}} checked{{/if}}>
                                            Receive email notifications
                                        </label>
                                    </div>
                                </fieldset>

                                <button type="submit" style="padding: 10px 20px; background-color: #333; color: white; border: none; cursor: pointer; width: 100%;">Save Profile</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{> footer }}
    </div>
</body>
</html>