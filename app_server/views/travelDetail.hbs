<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <div id="backgroud">
        <div id="page">
            {{> header }}
            <div id="contents">
                <div class="box">
                    <div class="body">
                        {{#if message}}
                            <p>{{message}}</p>
                        {{else}}
                            <h1>{{trip.name}}</h1>
                            <img src="/images/{{trip.image}}" alt="Img">
                            {{{trip.description}}}
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
        {{> footer }}
    </div>
</body>
</html>